# Google Colab CLI (A100 is enforced at runtime)
FORMFRAME_COLAB_CLI=/absolute/path/to/colab
FORMFRAME_COLAB_AUTH=adc
# OAuth only: accept Google's narrower Colab token when the optional Drive
# scope is omitted. FormFrame never mounts or uses Google Drive.
# OAUTHLIB_RELAX_TOKEN_SCOPE=1
FORMFRAME_COLAB_SESSION=formframe-a100
FORMFRAME_COLAB_GPU=A100
# Optional Colab CLI session-state path:
# FORMFRAME_COLAB_CONFIG=/absolute/path/to/colab-cli-state.json
# Optional local Mac cache for source-revision and model-manifest metadata.
# Model weights are restored inside the active Colab session, not downloaded here.
# FORMFRAME_REMOTE_CACHE_DIR=/absolute/path/to/FormFrame/data/remote-cache
# Set GOOGLE_APPLICATION_CREDENTIALS outside this file or point it at your private ADC JSON.

# Private GitHub source cloned by Colab bootstrap into /content/formframe/source.
# Pin FORMFRAME_GITHUB_REVISION to the exact commit that Colab should run.
FORMFRAME_GITHUB_REPO_URL=https://github.com/your-org/FormFrame.git
FORMFRAME_GITHUB_REVISION=0123456789abcdef0123456789abcdef01234567
# Optional for private repositories. Passed through runtime secrets/askpass only.
# FORMFRAME_GITHUB_TOKEN=

# `quick` creates an ephemeral trycloudflare.com URL for live validation and
# protects the gateway with a fresh random bearer token generated on the Mac.
# `managed` keeps the stable hostname + Access configuration below.
FORMFRAME_CF_TUNNEL_MODE=managed

# Stable named Cloudflare Tunnel and Access application (managed mode)
FORMFRAME_GATEWAY_URL=https://render.example.com
FORMFRAME_CF_TUNNEL_TOKEN=
FORMFRAME_CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
FORMFRAME_CF_ACCESS_AUDIENCE=
FORMFRAME_CF_ACCESS_CLIENT_ID=
FORMFRAME_CF_ACCESS_CLIENT_SECRET=
# Optional explicit bearer token for quick/development mode. Leave unset to
# generate an in-memory token for each FormFrame runtime.
# FORMFRAME_GATEWAY_DEVELOPMENT_TOKEN=

# Local personal-use geometry. These licensed files stay on the Mac; only
# derived RGB/depth/pose conditioning is sent to Colab.
FORMFRAME_GNM_CHECKOUT=/absolute/path/to/FormFrame/data/models/gnm
FORMFRAME_SMPLX_MODEL_DIR=/absolute/path/to/FormFrame/data/models/smplx
FORMFRAME_GEOMETRY_PYTHON=/absolute/path/to/FormFrame/data/geometry-venv/bin/python
